<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch card surface. Radius and border come from the shared card tokens so every gradient
    card in the app is geometrically identical to the flat ones; do not introduce a second
    radius here.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/grad_launch_start"
                android:endColor="@color/grad_launch_end"
                android:angle="90" />
            <corners android:radius="@dimen/chimera_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/chimera_card_border_width"
                android:color="@color/card_border" />
            <corners android:radius="@dimen/chimera_card_radius" />
        </shape>
    </item>
</layer-list>
