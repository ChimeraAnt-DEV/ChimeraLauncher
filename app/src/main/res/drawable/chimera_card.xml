<?xml version="1.0" encoding="utf-8"?>
<!--
    The one card surface. Every card in the launcher (hero, quick actions, settings rows,
    list items) points here via @style/Widget.Chimera.Card, so changes to radius or border
    are made once. Do not hand-roll another rounded rect.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/chimera_card_radius" />
    <solid android:color="@color/surface" />
    <stroke
        android:width="@dimen/chimera_card_border_width"
        android:color="@color/card_border" />
</shape>
