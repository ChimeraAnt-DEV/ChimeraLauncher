<?xml version="1.0" encoding="utf-8"?>
<!-- Static fallback for the orbitting dot (accent-tinted at runtime). Brand glow colours,
     not the old green/cyan pair. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="8dp"
        android:startColor="@color/glow_magenta"
        android:centerColor="@color/brand_primary_67"
        android:endColor="@color/brand_primary_0" />
    <size
        android:width="16dp"
        android:height="16dp" />
</shape>
