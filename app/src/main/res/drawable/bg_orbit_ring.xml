<?xml version="1.0" encoding="utf-8"?>
<!-- Static fallback for the splash orbit ring; SplashActivity replaces this with an
     accent-tinted GradientDrawable, so the colour here only matters before that runs. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="1dp"
        android:color="@color/glow_violet" />
    <size
        android:width="300dp"
        android:height="300dp" />
</shape>
