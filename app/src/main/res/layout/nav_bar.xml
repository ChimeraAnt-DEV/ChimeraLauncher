<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's side rail.

    A single vertical rail replaces the old horizontal seven-item top bar so the app's
    silhouette is no longer a top-bar clone. Every id here is load-bearing: BaseActivity
    resolves nav_tab_* by id, and PersonalizationManager tints nav_app_name /
    nav_sign_in_button. Keep the ids when changing the shape.

    BaseActivity.wrapWithNavBar inflates this to the start of a horizontal wrapper (the
    content sits to its end), so the root is a vertical rail, not a header.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    style="@style/Widget.Chimera.NavRail">

    <!--
        The rail column. Everything except the end-edge separator lives here; the separator
        is a sibling so it can span the full height instead of fighting the column layout.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!--
        Brand header: back affordance + mark on one row, name beneath. Kept deliberately
        short (40dp of a ~360dp landscape window) because the rail must fit six tab rows
        plus the footer in the same column; a tall header pushed the lower tabs out of
        view entirely.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/nav_back_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:rotation="90"
                android:src="@drawable/ic_arrow_down"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/nav_launch"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/nav_logo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chimera_ant"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="@color/accent_text"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="14dp"
        android:background="@color/divider" />

    <!--
        Tab list. Each item is an icon-over-label column with a 4dp accent indicator pinned
        to the start edge; BaseActivity shows/hides that indicator per active tab. The list
        scrolls so six labelled tabs still fit a short landscape window.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <FrameLayout
                android:id="@+id/nav_item_launch"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_launch"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_launch"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_nav_launch"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_launch"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_launch" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_item_instances"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_instances"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_instances"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_nav_instances"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_instances"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_instances" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_item_installations"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_installations"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_installations"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_nav_installations"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_installations"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_installations" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_item_mods"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_mods"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_mods"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_inbuilt_mods"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_mods"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_mods" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_item_customize"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_customize"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_customize"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_nav_controller"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_customize"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_customize" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_item_settings"
                style="@style/Widget.Chimera.NavRail.Item">

                <View
                    android:id="@+id/nav_indicator_settings"
                    android:layout_width="@dimen/chimera_rail_indicator_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginVertical="@dimen/chimera_rail_indicator_inset"
                    android:background="@color/primary"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/nav_tab_settings"
                        style="@style/Widget.Chimera.NavRail.Item.Icon"
                        android:src="@drawable/ic_nav_settings"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/nav_label_settings"
                        style="@style/Widget.Chimera.NavRail.Item.Label"
                        android:text="@string/nav_settings" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="14dp"
        android:background="@color/divider" />

    <!-- Footer: news bell, sign-in / avatar. Stacked because the rail is narrow. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <FrameLayout
            android:id="@+id/nav_news_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/news_title"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_news_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/news_title"
                android:src="@drawable/ic_nav_news"
                app:tint="@color/text_secondary" />

            <View
                android:id="@+id/nav_news_badge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_news_unread_dot"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/nav_sign_in_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:minWidth="0dp"
            android:minHeight="26dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/misans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:backgroundTint="@color/primary"
            android:text="@string/sign_in"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nav_account_avatar_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <com.microsoft.xbox.idp.toolkit.CircleImageView
                android:id="@+id/nav_account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/xbox_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_minecraft_cube" />

            <ProgressBar
                android:id="@+id/nav_avatar_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    </LinearLayout>

    <!-- Separator against the content, tinted by BaseActivity when a wallpaper is set. -->
    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/divider" />

</FrameLayout>
